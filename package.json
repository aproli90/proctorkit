{
  "name": "proctorkit",
  "version": "0.1.0",
  "description": "Proctoring for the quiz you already built: a browser SDK for system checks, consent, full-screen and entire-screen-share guards, camera and face-in-view checks, snapshots and a per-question event log. Optional hosted checks and report links.",
  "keywords": [
    "proctoring",
    "proctor",
    "online-proctoring",
    "exam",
    "quiz",
    "assessment",
    "hiring-test",
    "anti-cheat",
    "cheating-detection",
    "online-test",
    "invigilation",
    "webcam",
    "screen-share",
    "remote-exam"
  ],
  "license": "MIT",
  "author": "Ashhar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aproli90/proctorkit.git"
  },
  "type": "module",
  "main": "./dist/proctorkit.js",
  "module": "./dist/proctorkit.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/proctorkit.global.js",
  "jsdelivr": "./dist/proctorkit.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/proctorkit.js",
      "default": "./dist/proctorkit.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node test/smoke.mjs"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "typescript": "^5.6.0"
  },
  "homepage": "https://github.com/aproli90/proctorkit#readme",
  "bugs": {
    "url": "https://github.com/aproli90/proctorkit/issues"
  }
}
